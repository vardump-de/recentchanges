<div class="recententries-container">
    {% if entries|length %}
        <table class="data fullwidth">
            {% for entry in entries %}
                {% set className = className(entry) %}
                <tr>
                    <td>
                        <span class="status {{ entry.status }} "></span>
                        <a href="{{ entry.getCpEditUrl() }}">{{ entry.title ?? "no title defined"|t('recentchanges') }}</a>
                        <span class="light">
                            {{ entry.dateUpdated|timestamp('short') }}
                            {% if entry.hasRevisions() and entry.getCurrentRevision() %}
                                    , {{ entry.getCurrentRevision().getCreator().username }}
                             {% elseif entry.author %}
                                    , {{ entry.author.username }}
                            {% endif %}
                        </span>
                    </td>
                </tr>
            {% endfor %}
        </table>
    {% else %}
        <p>{{ "No entries exist yet."|t('recentchanges') }}</p>
    {% endif %}
</div>
